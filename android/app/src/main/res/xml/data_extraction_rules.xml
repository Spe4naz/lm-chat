<?xml version="1.0" encoding="utf-8"?>
<!--
  The chat history is local-only. API keys and bridge tokens are stored in the
  platform keystore and are not part of the exported history. Backups are
  excluded as well: a manual JSON profile export exists for migration.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
